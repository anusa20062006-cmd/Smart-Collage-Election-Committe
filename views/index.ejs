            </p>

            <h1>
                Smart College
                <span>Election Committee</span>
            </h1>

            <p class="hero-description">
                A secure and smart digital platform for managing
                college elections, candidates, students and voting.
            </p>

            
<div class="hero-buttons">

    <a href="/student/login" class="btn primary-btn">
        Student Login
    </a>

    <a href="/candidate/login" class="btn secondary-btn">
        Candidate Login
    </a>

    <a href="/admin/login" class="btn admin-btn">
        Admin Login
    </a>

</div>


</div>

        </div>


        <!-- Vote Card -->
        <div class="vote-card">

            <div class="vote-icon">
                🗳️
            </div>

            <h2>Your Vote</h2>

            <h3>Your Voice</h3>

            <div class="vote-line"></div>

            <p>
                Secure • Transparent • Fair
            </p>

        </div>

    </section>


    <!-- About Section -->
    <section class="about-section" id="about">

        <p class="section-label">
            ABOUT THE SYSTEM
        </p>

        <h2>
            Making College Elections Smarter
        </h2>

        <p class="section-description">
            Smart College Election Committee is a web-based election
            management system designed to simplify and digitalize
            the complete college election process.
        </p>

    </section>


    <!-- Features Section -->
    <section class="features-section" id="features">

        <p class="section-label">
            KEY FEATURES
        </p>

        <h2>
            Everything in One Place
        </h2>


        <div class="feature-container">

            <div class="feature-card">

                <div class="feature-icon">
                    🔐
                </div>

                <h3>
                    Secure Login
                </h3>

                <p>
                    Separate secure access for administrators,
                    students and candidates.
                </p>

            </div>


            <div class="feature-card">

                <div class="feature-icon">
                    👥
                </div>

                <h3>
                    Candidate Management
                </h3>

                <p>
                    Manage candidate registration and election
                    information efficiently.
                </p>

            </div>


            <div class="feature-card">

                <div class="feature-icon">
                    🗳️
                </div>

                <h3>
                    Digital Voting
                </h3>

                <p>
                    Students can cast their votes through a
                    simple and convenient digital interface.
                </p>

            </div>


            <div class="feature-card">

                <div class="feature-icon">
                    📊
                </div>

                <h3>
                    Live Results
                </h3>

                <p>
                    View organized election results and vote
                    counts through the administrator dashboard.
                </p>

            </div>

        </div>

    </section>


    <!-- Portal Section -->
    <section class="portal-section">

        <p class="section-label">
            GET STARTED
        </p>

        <h2>
            Choose Your Portal
        </h2>


        <div class="portal-container">

            <!-- Admin -->
            <a href="/admin-login" class="portal-card">

                <div class="portal-icon">
                    👨‍💼
                </div>

                <h3>
                    Admin Portal
                </h3>

                <p>
                    Manage the complete election process
                </p>

            </a>


            <!-- Student -->
            <a href="/student-login" class="portal-card">

                <div class="portal-icon">
                    🎓
                </div>

                <h3>
                    Student Portal
                </h3>

                <p>
                    Participate and cast your vote
                </p>

            </a>


            <!-- Candidate -->
            <a href="/candidate-login" class="portal-card">

                <div class="portal-icon">
                    🏆
                </div>

                <h3>
                    Candidate Portal
                </h3>

                <p>
                    Manage your election participation
                </p>

            </a>

        </div>

    </section>


    <!-- Footer -->
    <footer id="contact">

        <h3>
