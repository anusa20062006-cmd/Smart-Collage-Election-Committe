
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Candidate Management | Smart Election</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <header class="dashboard-nav">
        <div class="dashboard-logo">🗳️ Smart Election</div>
        <a href="/admin/dashboard" class="back-link">
            ← Back to Dashboard
        </a>
    </header>

    <main class="candidate-page">
        <div class="candidate-heading">
            <p class="section-label">ADMIN CONTROL PANEL</p>
            <h1>Candidate Management</h1>
            <p>Review candidate applications and manage election participation.</p>
        </div>

        <section class="candidate-summary">
            <div class="candidate-summary-card">
                <span>📋</span>
                <h3>Total Applications</h3>
                <p>0</p>
            </div>

            <div class="candidate-summary-card">
                <span>✅</span>
                <h3>Approved</h3>
                <p>0</p>
            </div>

            <div class="candidate-summary-card">
                <span>⏳</span>
                <h3>Pending Review</h3>
                <p>0</p>
            </div>
        </section>

        <section class="applications-section">
            <h2>Candidate Applications</h2>

            <div class="empty-applications">
                <div class="empty-icon">👥</div>
                <h3>No applications yet</h3>
                <p>
                    Candidate applications will appear here when
                    candidates register for the college election.
                </p>
            </div>
        </section>
    </main>

</body>
</html>
