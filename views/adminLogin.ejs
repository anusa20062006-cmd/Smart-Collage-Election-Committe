<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Admin Login - Smart College Election Committee</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="login-page admin-page">

    <div class="login-container">

        <div class="login-box">

            <h1>Admin Login</h1>

            <p>Login to manage the college election committee</p>

            <form action="/admin/login" method="POST">

                <label for="username">Username</label>
                <input 
                    type="text"
                    id="username"
                    name="username"
                    placeholder="Enter admin username"
                    required
                >

                <label for="password">Password</label>
                <input 
                    type="password"
                    id="password"
                    name="password"
                    placeholder="Enter admin password"
                    required
                >

                <button type="submit" class="login-submit">
                    Login
                </button>

            </form>

            <a href="/" class="back-link">
                ← Back to Home
            </a>

        </div>

    </div>

</body>
</html>