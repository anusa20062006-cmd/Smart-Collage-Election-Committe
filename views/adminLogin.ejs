<!DOCTYPE html>
<html>
<head>
    <title>Admin Login</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<div class="container">

    <h1>Admin Login</h1>

    <form action="/admin/login" method="POST">

        <input
            type="text"
            name="username"
            placeholder="Enter Username"
            required
        >

        <br><br>

        <input
            type="password"
            name="password"
            placeholder="Enter Password"
            required
        >

        <br><br>

        <button type="submit">Login</button>

    </form>

</div>

</body>
</html>